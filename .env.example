# Local test orders only. Never enable this SQLite adapter for public commerce.
COMMERCE_TEST_ORDERS=0
# Private 32+ character random bearer token. Never prefix with NEXT_PUBLIC_.
OWNER_ACCESS_TOKEN=
# Optional persistent local test database path. Default: .data/test-orders.sqlite
# TEST_ORDER_DB_PATH=
# Set to 1 when running the local test server through HTTPS.
COOKIE_SECURE=0
